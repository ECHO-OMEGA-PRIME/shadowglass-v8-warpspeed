[Unit]
Description=ShadowGlass v8 WarpSpeed canary-only consumer proof
After=network-online.target postgresql.service shadowglass-master.service shadowglass-v8-warpspeed.service
Wants=network-online.target shadowglass-master.service

[Service]
Type=simple
User=shadowglass-v8-consumer
Group=shadowglass-v8-consumer
WorkingDirectory=/opt/shadowglass-v8-runtime
BindReadOnlyPaths=/home/forge/shadowglass-v8-warpspeed/current:/opt/shadowglass-v8-runtime
InaccessiblePaths=-/opt/shadowglass-v8-runtime/src -/opt/shadowglass-v8-runtime/evidence -/opt/shadowglass-v8-runtime/legacy
LoadCredential=database_url:/etc/echo/credentials/shadowglass-v8-warpspeed/consumer-database-url
LoadCredential=relay_url:/etc/echo/credentials/shadowglass-v8-warpspeed/relay-url
LoadCredential=relay_allowed_hosts:/etc/echo/credentials/shadowglass-v8-warpspeed/relay-allowed-hosts
LoadCredential=minio_endpoint:/etc/echo/credentials/shadowglass-v8-warpspeed/minio-endpoint
LoadCredential=minio_access_key:/etc/echo/credentials/shadowglass-v8-warpspeed/minio-access-key
LoadCredential=minio_secret_key:/etc/echo/credentials/shadowglass-v8-warpspeed/minio-secret-key
LoadCredential=minio_bucket:/etc/echo/credentials/shadowglass-v8-warpspeed/minio-bucket
ExecStart=/opt/shadowglass-v8-runtime/.venv/bin/python /opt/shadowglass-v8-runtime/queue_worker.py --loop --claim-kind acceptance_canary --worker-id forge-shadowglass-v8-proof --idle-seconds 0.2 --lease-seconds 60
Restart=no
TimeoutStartSec=30
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=tmpfs
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
TasksMax=32
LimitNOFILE=1024
